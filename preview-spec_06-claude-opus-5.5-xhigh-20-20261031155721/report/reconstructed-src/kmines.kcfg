<?xml version="1.0" encoding="UTF-8"?>
<!-- Reconstructed from the kconfig_compiler output in Settings::Settings (0x11e030).
     Group/key/label/default/min/max values are read from the binary; the
     Settings object layout is: +0x18 UseQuestionMarks, +0x19 AllowKminesReset,
     +0x1a DisableScoreOnReset, +0x1b ExploreWithLeftClickOnNumberCells,
     +0x1c PlaceFlagOn, +0x20 CustomWidth, +0x24 CustomHeight, +0x28 CustomMines. -->
<kcfg>
  <kcfgfile name="kminesrc"/>
  <group name="General">
    <entry name="UseQuestionMarks" type="Bool">
      <label>question mark</label>
      <default>true</default>
    </entry>
    <entry name="AllowKminesReset" type="Bool">
      <label>kmines_reset</label>
      <default>true</default>
    </entry>
    <entry name="DisableScoreOnReset" type="Bool">
      <label>disable_score_on_reset</label>
      <default>false</default>
    </entry>
    <entry name="ExploreWithLeftClickOnNumberCells" type="Bool">
      <label>explore_with_left_click_on_number_cells</label>
      <default>false</default>
    </entry>
    <entry name="PlaceFlagOn" type="Enum">
      <label>place_flag_on</label>
      <choices>
        <choice name="MouseRelease"/>
        <choice name="MousePress"/>
      </choices>
      <default>0</default>
    </entry>
  </group>
  <group name="Options">
    <entry name="CustomWidth" type="Int">
      <label>custom width</label>
      <default>10</default>
      <min>5</min>
      <max>50</max>
    </entry>
    <entry name="CustomHeight" type="Int">
      <label>custom height</label>
      <default>10</default>
      <min>5</min>
      <max>50</max>
    </entry>
    <entry name="CustomMines" type="Int">
      <label>custom mines</label>
      <default>20</default>
      <min>1</min>
      <!-- max is set at runtime: width*height-10 (CustomGameConfig::updateMaxMines) -->
    </entry>
  </group>
</kcfg>
